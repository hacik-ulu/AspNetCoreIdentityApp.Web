@using System.Security.Claims
@if (User.Identity!.IsAuthenticated)
{
    <ul class="nav me-0">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                @User.Identity.Name
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Member" asp-action="Index">Profil</a></li>
                <li><a class="dropdown-item" asp-controller="Member" asp-action="PasswordChange">Şifre Değiştir</a></li>
                <li><a class="dropdown-item" asp-controller="Member" asp-action="UserEdit">Kullanıcı Güncelle</a></li>
                @if (User.HasClaim(x => x.Type == ClaimTypes.Role && x.Value == "admin"))
                {
                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Users" asp-action="Index">Admin</a></li>
                }
                <li><a class="dropdown-item" asp-controller="Member" asp-action="Logout">Çıkış Yap</a></li>
            </ul>
        </li>
    </ul>
}

else
{
    <a class="btn btn-outline-success mx-1" asp-controller="Default" asp-action="SignIn">Üye Giriş</a>
    <a class="btn btn-outline-success" asp-controller="Default" asp-action="SignUp">Üye Kayıt</a>
}
