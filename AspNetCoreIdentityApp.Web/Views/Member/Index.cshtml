@model UserInfoViewModel


@{
    ViewData["Title"] = "Index";
}


<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-lg rounded-4 mt-5">
            <div class="card-header bg-primary text-white text-center rounded-top-4">
                <h3><i class="fas fa-user-circle me-2"></i>Kullanıcı Bilgileri</h3>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <tbody>
                        <tr>
                            <th><i class="fas fa-user me-2 text-primary"></i>Kullanıcı Adı</th>
                            <td>@Model.UserName</td>
                        </tr>
                        <tr>
                            <th><i class="fas fa-envelope me-2 text-primary"></i>Email</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th><i class="fas fa-phone me-2 text-primary"></i>Telefon No</th>
                            <td>@Model.PhoneNumber</td>
                        </tr>
                    </tbody>
                </table>
               @*  <div class="text-end">
                    <a href="/Kullanici/Guncelle" class="btn btn-outline-primary rounded-pill">
                        <i class="fas fa-edit me-1"></i> Bilgileri Güncelle
                    </a>
                </div> *@
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
